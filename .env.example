# Bu dosyayı .env.local olarak kopyalayıp gerçek değerlerle doldurun (yerel geliştirme için).
# Vercel'de bu değerleri Settings > Environment Variables kısmından gireceksiniz.
# MongoDB Atlas bağlantı adresiniz (Kendi adresinizle değiştirin)
MONGO_URI=mongodb+srv://<kullanici_adi>:<sifre>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Veritabanı adı
MONGO_DB_NAME=agm_bakim

# GÜVENLİK İÇİN ÖNEMLİ: Rastgele ve uzun bir metin yazın. 
# Örnek: "cok-gizli-ve-kimse-tahmin-edemeyecek-uzun-bir-yazi-12345"
JWT_SECRET=buraya_cok_gizli_ve_uzun_bir_rastgele_dize_yazin
