# Bu dosyayı .env.local olarak kopyalayıp gerçek değerlerle doldurun (yerel geliştirme için).
# Vercel'de bu değerleri Settings > Environment Variables kısmından gireceksiniz.
# MongoDB Atlas bağlantı adresiniz (Kendi adresinizle değiştirin)
MONGO_URI=mongodb+srv://<kullanici_adi>:<sifre>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Veritabanı adı
MONGO_DB_NAME=agm_bakim

# GÜVENLİK İÇİN ÖNEMLİ: Rastgele ve uzun bir metin yazın. 
# Örnek: "cok-gizli-ve-kimse-tahmin-edemeyecek-uzun-bir-yazi-12345"
JWT_SECRET=buraya_cok_gizli_ve_uzun_bir_rastgele_dize_yazin

# Dağıtık rate limit için Upstash Redis REST bağlantısı.
# Production’da bu iki değer yoksa kritik yazma/login endpoint’leri güvenli biçimde 503 döner.
UPSTASH_REDIS_REST_URL=https://ornek-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=buraya_redis_rest_token
# JWT_SECRET’ten ayrı, uzun ve rastgele anahtar önerilir.
RATE_LIMIT_KEY_SECRET=buraya_rate_limit_hmac_anahtari
RATE_LIMIT_REDIS_TIMEOUT_MS=750

# Web Push VAPID ayarları. Anahtarları `npx web-push generate-vapid-keys` ile üretin.
# VAPID_PRIVATE_KEY yalnızca sunucu ortamında tutulmalı, istemciye gönderilmemelidir.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=buraya_vapid_public_key
VAPID_PRIVATE_KEY=buraya_vapid_private_key

# Vercel Blob Store. Vercel Storage > Create Database > Blob bağlantısı bunları otomatik ekler.
# Büyük medya dosyaları tarayıcıdan doğrudan Blob'a gönderilir.
BLOB_STORE_ID=vercel_blob_store_id
BLOB_READ_WRITE_TOKEN=vercel_blob_read_write_token

# PDF URL allowlist’i. Varsayılan olarak Vercel Blob public hostları kabul edilir;
# özel bir HTTPS PDF depolama hostu kullanılacaksa virgülle ayırarak ekleyin.
PDF_ALLOWED_HOSTS=
# Varsayılan push servisleri dışında kullanılan HTTPS push hostları varsa ekleyin.
PUSH_ALLOWED_HOSTS=

# Yeni/alternatif Blob Store bağlantısı için özel prefix kullanılıyorsa:
MEDIA_READ_WRITE_TOKEN=media_read_write_token
MEDIA_STORE_ID=media_store_id
MEDIA_WEBHOOK_PUBLIC_KEY=media_webhook_public_key
# Yalnızca Preview’da yeni hassas rapor/yağ analizi upload’larını private-pilot/ prefix’ine alır.
# Production’da false veya unset kalmalıdır. Varsayılan private store MEDIA_STORE_ID’dir.
PRIVATE_BLOB_PILOT_ENABLED=false
PRIVATE_BLOB_STORE_ID=

# Vercel Cron endpoint güvenliği için uzun rastgele bir secret.
CRON_SECRET=vercel_cron_secret_buraya
