    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "NODE_OPTIONS=--experimental-strip-types eslint --flag unstable_native_nodejs_ts_config app components lib",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "smoke:readonly": "node --experimental-strip-types scripts/smoke-readonly.mts",
    "migrate:stable-keys": "node --experimental-strip-types scripts/migrate-stable-keys.mts",
