    "bcryptjs": "^2.4.3",
    "exceljs": "4.4.0",
    "jose": "^5.9.6",
    "jszip": "3.10.1",
    "mongodb": "^6.9.0",
    "next": "15.5.21",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
