    "migrate:legacy-oil-pdfs:vercel-dry-run": "node --experimental-strip-types scripts/vercel-legacy-oil-pdf-dry-run.mts",
    "migrate:legacy-oil-pdfs:vercel-pilot": "node --experimental-strip-types scripts/vercel-legacy-oil-pdf-pilot.mts",
    "migrate:legacy-oil-pdfs:vercel-verify": "node --experimental-strip-types scripts/vercel-legacy-oil-pdf-verify.mts",
    "migrate:legacy-oil-pdfs:vercel-batch-a": "node --experimental-strip-types scripts/vercel-legacy-oil-pdf-batch-a.mts",
    "migrate:legacy-oil-pdfs:vercel-batch-a-verify": "node --experimental-strip-types scripts/vercel-legacy-oil-pdf-batch-a-verify.mts",
    "migrate:legacy-oil-pdfs:vercel-batch-b": "node --experimental-strip-types scripts/vercel-legacy-oil-pdf-batch-b.mts",
